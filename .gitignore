# Godot 4+ specific ignores
.godot/
/android/
*.eps

# macOS Finder metadata — should never be tracked
.DS_Store
**/.DS_Store

# Build artifacts
*.apk
*.apk.idsig
*.aab
*.idsig
/build/

# Signing — secrets/ has its own .gitignore that whitelists only
# the env example + READMEs, but belt-and-braces here too.
secrets/*.keystore
secrets/keystore.env

# Claude worktrees (each agent session creates one — never commit)
.claude/worktrees/

# IDE / editor scratch
.idea/
script_templates/

# Stray asset experiments (one-off tests outside the proper folders)
/Assets/OurAssets/walls/tileset1_base.png
/Assets/OurAssets/walls/tileset1_base.png.import
