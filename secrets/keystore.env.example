# Copy this file to `secrets/keystore.env` and fill in real values.
# `keystore.env` is gitignored — never commit it.
#
# `scripts/build/build_android.sh` reads these variables and passes
# them to Godot's export step. Same names are used by the CI workflow
# (loaded from GitHub Actions secrets).

# Release keystore (created by scripts/build/create_keystore.sh).
EFH_RELEASE_KEYSTORE_PATH="secrets/release.keystore"
EFH_RELEASE_KEYSTORE_USER="escape_from_hell"
EFH_RELEASE_KEYSTORE_PASS="REPLACE_WITH_REAL_PASSWORD"

# Debug keystore — usually fine to share among devs, but the
# password still doesn't belong in git.
EFH_DEBUG_KEYSTORE_PATH="secrets/debug.keystore"
EFH_DEBUG_KEYSTORE_USER="androiddebugkey"
EFH_DEBUG_KEYSTORE_PASS="android"
