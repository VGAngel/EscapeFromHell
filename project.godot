; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EscapeFromHell"
config/version="0.1.0"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
DisplaySettings="*res://scripts/managers/DisplaySettings.gd"
GameManager="*res://scripts/managers/GameManager.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"
LevelConfig="*res://scripts/managers/LevelConfig.gd"
AdsManager="*res://scripts/managers/AdsManager.gd"
SafeArea="*res://scripts/ui/SafeArea.gd"
TutorialManager="*res://scripts/managers/TutorialManager.gd"
LevelGenerator="*res://scripts/levels/LevelGenerator.gd"
SceneTransition="*res://scripts/managers/SceneTransition.gd"
CameraShake="*res://scripts/managers/CameraShake.gd"
SoundManager="*res://scripts/managers/SoundManager.gd"
ParticleEffects="*res://scripts/managers/ParticleEffects.gd"
Loc="*res://scripts/managers/LocalizationManager.gd"
DebugOverlay="*res://scripts/managers/DebugOverlay.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="viewport"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/beehave/plugin.cfg")

