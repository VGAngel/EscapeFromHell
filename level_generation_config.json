  "procedural_levels": {
    "note": "~65 рівнів збираються з кімнат-блоків при завантаженні рівня.",
    "total_procedural_estimate": "~65 рівнів",

    "assembly": {
      "method": "sequential_rooms",
      "room_count_per_level": { "min": 2, "max": 8 },
      "note": "Рівень = послідовність кімнат. Перша кімната — вхід, остання — вихід.",

      "room_types": {
        "entrance": {
          "count": 1,
          "position": "first",
          "note": "Завжди безпечна — ворогів немає, гравець орієнтується"
        },
        "main": {
          "count": "1-4",
          "position": "middle",
          "note": "Основний контент: вороги, душі, пастки, платформи"
        },
        "exit": {
          "count": 1,
          "position": "last",
          "note": "Вихід з рівня. Може мати охорону."
        }
      },

      "soul_placement": {
        "method": "pick_from_circle_pool",
        "note": "Для кожного рівня береться відповідна іменна душа з souls_collection.json. Розміщується в main кімнаті за правилами кола.",
        "guard_rules": "soul_mechanics_config.json guard_scaling"
      },

      "seed": {
        "based_on": "level_id",
        "note": "Однаковий рівень завжди генерується однаково. Гравець може вивчити рівень при повторній спробі."
      }
    },

