    "hidden_soul_levels": {
      "note": "Рівні де є приховані душі — статичні щоб підказки і розміщення були точними.",
      "determined_by": "souls_collection.json hidden souls circle/level fields"
    },

    "milestone_levels": [50, 75, 99, 100],

    "total_static_estimate": "~35 рівнів"
